{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.chatgpt.orchestrator.phase5-recovery/v1",
  "title": "Phase 5 process and session recovery contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "transitions", "stable_tools", "audit", "recovery_actions", "invariants", "behavior_tests"],
  "properties": {
    "schema": {"const": "codex.chatgpt.orchestrator.phase5-recovery/v1"},
    "transitions": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}, "const": {"plan": ["plan", "review", "web-multi", "pro"], "pro": ["review"], "web-multi": ["review"], "review": ["implementation"], "implementation": ["final-web-gate"], "final-web-gate": ["complete", "implementation"]}},
    "stable_tools": {"type": "object", "additionalProperties": false, "required": ["StateStore", "LockManager", "StageGate", "ProcessSupervisor", "ProfileManager"], "properties": {"StateStore": {"implementation": "write-file-atomic", "guarantees": ["atomic_json_write", "receipt_before_unlock"]}, "LockManager": {"implementation": "proper-lockfile", "guarantees": ["single_submit_per_project", "idempotent_release"]}, "StageGate": {"implementation": "deterministic_local_gate", "guarantees": ["legal_transition", "immutable_bindings", "marker_and_receipt_validation"]}, "ProcessSupervisor": {"implementation": "execa", "guarantees": ["process_tree_tracking", "terminate_all_descendants_before_retry"]}, "ProfileManager": {"implementation": "--copy-profile", "guarantees": ["throwaway_profile_from_manual_login_seed", "never_write_credentials_to_seed"]}}},
    "audit": {"type": "object", "additionalProperties": false, "required": ["seconds", "kind", "effects"], "properties": {"seconds": {"const": 4800}, "kind": {"const": "caution/status-audit"}, "effects": {"type": "object", "additionalProperties": false, "properties": {"is_timeout": {"const": false}, "releases_ownership": {"const": false}, "authorizes_new_submission": {"const": false}, "marks_failure": {"const": false}}, "required": ["is_timeout", "releases_ownership", "authorizes_new_submission", "marks_failure"]}}},
    "recovery_actions": {"type": "object", "additionalProperties": false, "required": ["login_failure", "devspace_unreachable", "process_exists"], "properties": {"login_failure": {"type": "object", "required": ["command", "result"], "properties": {"command": {"const": "--open-profile-login"}, "result": {"const": "USER_ACTION_REQUIRED"}}, "additionalProperties": false}, "devspace_unreachable": {"type": "object", "required": ["attempt", "on_failure"], "properties": {"attempt": {"const": "reconnect_exact_root_once"}, "on_failure": {"const": "BLOCKED"}}, "additionalProperties": false}, "process_exists": {"type": "object", "required": ["action", "retry_guard"], "properties": {"action": {"const": "terminate_process_tree"}, "retry_guard": {"const": "all_descendants_absent"}}, "additionalProperties": false}}},
    "invariants": {"const": ["recovery retains run_id, project_root, mission_sha256, semantic_revision", "submitted_unknown is never expired by elapsed time", "exact-slug recovery cannot create a replacement submission", "session authority is monotonic", "all descendants must be absent before retry"]},
    "behavior_tests": {"const": ["orphan and stale state resumes from the last valid receipt", "StateStore concurrent writes remain one complete JSON document", "LockManager permits one concurrent submit per project", "ProcessSupervisor kills the complete process tree", "doctor --recover selects exactly one diagnosis action"]}
  }
}
